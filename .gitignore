# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python

# Entornos virtuales y portable (muy pesados, se obtienen por separado)
.venv/
venv/
env/
portable/

# Caches de herramientas
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Outputs generados (se regeneran al correr la app)
output/
recortes_firmas/
build/

# Banco de trabajo: scripts sueltos, corridas de prueba, salidas de pytest y
# lo que haga falta dejar a mano un rato. Nada de aqui es del proyecto y nada
# de aqui se commitea; se puede borrar entero cuando estorbe.
tmp/

# Directorio de entrada (PDFs escaneados, descargables por separado)
input/*
!input/.gitkeep

# Archivo huérfano (de una mala redirección de shell)
=1.8.0

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Preferencias de la copia portable (se generan al usar la aplicación)
important_fields.json

.claude/
.vscode/
.agents/
img/

# Cache de flota que arma el indexado de AirVault
airvault_flota.json

# Turno de cada libro en la ronda de comprobacion (local de cada instalacion,
# cambia en cada indexado y no dice nada fuera de su maquina)
book_ronda.json
